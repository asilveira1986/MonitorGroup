{
  "name": "monitorgroup-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Worker que conecta ao WhatsApp (QR code), captura mensagens dos grupos e dispara alertas",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@supabase/supabase-js": "^2.117.2",
    "baileys": "^7.0.0-rc14",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
