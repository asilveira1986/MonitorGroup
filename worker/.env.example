# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Envio de alertas por e-mail (opcional) - https://resend.com
RESEND_API_KEY=
ALERT_EMAIL_FROM=Monitor WhatsApp <alertas@seudominio.com>

# Link do painel usado nas notificações
APP_URL=https://seu-painel.vercel.app

# Automação de atendimento (acuse, aviso e cobrança)
# Endereço do painel nos avisos (sem ele, usa APP_URL)
PANEL_URL=https://www.groupmonitor.com.br
# Intervalo mínimo entre as mensagens enviadas pela automação (reduz o risco de bloqueio do número)
SEND_MIN_INTERVAL_MS=1500
# Fuso do horário de atendimento quando a empresa não tem um configurado
TZ_ATENDIMENTO=America/Sao_Paulo

# Porta do healthcheck (Railway/Render definem automaticamente)
PORT=8080
LOG_LEVEL=info
